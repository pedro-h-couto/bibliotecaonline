{
    "name": "aluno/biblioteca-api",
    "description": "API REST para Gestao de Biblioteca com Slim 4, JWT e arquitetura em camadas",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Aluno",
            "email": "aluno@example.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Api\\": ""
        }
    },
    "require": {
        "slim/slim": "^4.10",
        "slim/psr7": "^1.6",
        "firebase/php-jwt": "^6.4",
        "php-di/php-di": "^6.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "scripts": {
        "start": "php -S localhost:8080 -t src/public",
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage/",
        "composer-update": "composer update",
        "composer-dump": "composer dump-autoload"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        },
        "audit": {
            "block-insecure": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}